# DBR² edge proxy. DBR2_TLS is "internal" (Caddy's local CA) or
# "/certs/<cert>.pem /certs/<key>.pem" for your own certificate.
{
	admin off
}

# Internal liveness endpoint (not published): probed by dbr2-server's
# readiness check and by the container HEALTHCHECK.
http://:8090 {
	respond /healthz "ok" 200
	respond 404
}

{$DBR2_HOSTNAME} {
	tls {$DBR2_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# API, OpenAPI documents and Swagger UI go straight to the control plane.
	handle /api/* {
		reverse_proxy dbr2-server:8080
	}
	handle {
		reverse_proxy dbr2-web:3000
	}
}
