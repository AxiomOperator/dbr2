{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AxiomOperator/dbr2/internal/manifest/schema/v1.json",
  "title": "DBR² recovery manifest, schema_version 1",
  "description": "Written last, by maint@dbr2, as a pinned Kopia snapshot (source maint@dbr2:/manifests/<application_id>, file manifest.json, tags dbr2-kind=manifest, dbr2-rp, dbr2-app). A recovery point exists if and only if this document exists in the Repository (ADR-0003, ADR-0004). Additional properties are allowed: changes within schema major 1 are additive.",
  "type": "object",
  "required": ["schema_version", "recovery_point_id", "status", "created_at", "consistency_mode", "consistency_point", "crash_consistent_only", "application", "source", "repository", "components", "workflow", "producer"],
  "properties": {
    "schema_version": { "const": 1 },
    "recovery_point_id": { "type": "string", "pattern": "^rp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "status": { "enum": ["complete", "partial"] },
    "created_at": { "type": "string", "format": "date-time" },
    "consistency_mode": { "enum": ["live", "quiesced", "offline"] },
    "consistency_point": { "type": "string", "format": "date-time", "description": "Quiesce start (quiesced, offline) or capture start (live)." },
    "crash_consistent_only": { "type": "boolean" },
    "quiesce_started_at": { "type": "string", "format": "date-time" },
    "quiesce_ended_at": { "type": "string", "format": "date-time" },
    "auto_resumed": { "type": "boolean", "description": "The agent dead-man switch resumed the application during capture (ADR-0005)." },
    "application": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "compose_project": { "type": "string" },
        "working_dir": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["host_id", "agent_id", "hostname"],
      "properties": {
        "host_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string" },
        "os_release": { "type": "string" },
        "architecture": { "type": "string" },
        "runtime_version": { "type": "string" },
        "agent_version": { "type": "string" }
      }
    },
    "repository": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" } }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": { "service": { "type": "string" }, "ref": { "type": "string" }, "digest": { "type": "string" } }
      }
    },
    "topology": {
      "type": "object",
      "description": "Containers, networks and volumes at capture time (no secrets). Optional: absent before Phase 5.",
      "required": ["containers"],
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "image", "state"],
            "properties": {
              "id": { "type": "string" }, "name": { "type": "string" }, "service": { "type": "string" },
              "image": { "type": "string" }, "state": { "type": "string" },
              "ports": { "type": "array", "items": { "type": "object", "required": ["container_port", "protocol"],
                "properties": { "container_port": { "type": "string" }, "protocol": { "type": "string" }, "host_ip": { "type": "string" }, "host_port": { "type": "string" } } } },
              "mounts": { "type": "array", "items": { "type": "object", "required": ["type", "destination", "rw"],
                "properties": { "type": { "type": "string" }, "name": { "type": "string" }, "source": { "type": "string" }, "destination": { "type": "string" }, "rw": { "type": "boolean" } } } },
              "networks": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "networks": { "type": "array", "items": { "type": "object", "required": ["name", "driver"],
          "properties": { "name": { "type": "string" }, "driver": { "type": "string" }, "external": { "type": "boolean" }, "internal": { "type": "boolean" }, "attachable": { "type": "boolean" }, "labels": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "volumes": { "type": "array", "items": { "type": "object", "required": ["name", "driver"],
          "properties": { "name": { "type": "string" }, "driver": { "type": "string" }, "external": { "type": "boolean" }, "labels": { "type": "object", "additionalProperties": { "type": "string" } } } } }
      }
    },
    "contract": {
      "type": "object",
      "required": ["satisfied"],
      "properties": { "id": { "type": "string" }, "satisfied": { "type": "boolean" }, "details": {} }
    },
    "workflow": {
      "type": "object",
      "required": ["workflow_id", "run_id"],
      "properties": { "workflow_id": { "type": "string", "minLength": 1 }, "run_id": { "type": "string", "minLength": 1 }, "trigger": { "type": "string" } }
    },
    "producer": {
      "type": "object",
      "required": ["component", "version"],
      "properties": { "component": { "type": "string" }, "version": { "type": "string" } }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["name", "kind", "required", "status", "size_bytes", "started_at", "finished_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["config", "volume", "bind_mount", "database", "image", "fsmeta"] },
        "required": { "type": "boolean" },
        "status": { "enum": ["succeeded", "failed", "skipped"] },
        "error": { "type": "string" },
        "snapshot_id": { "type": "string" },
        "root_object_id": { "type": "string" },
        "snapshot_source": { "type": "string", "description": "user@host:path; for agent components user is 'agent' and host is the agent ID." },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "path": { "type": "string" },
        "volume_name": { "type": "string" },
        "owner_uid": { "type": "integer", "minimum": 0 },
        "owner_gid": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string" },
        "selinux_context": { "type": "string" },
        "parent": { "type": "string", "description": "fsmeta components: the filesystem component they describe." },
        "capture_method": { "enum": ["live", "snapshot"] },
        "file_name": { "type": "string", "description": "Single-stream components: the file name inside the snapshot." },
        "validation": { "type": "string", "description": "Check performed on the captured data (database dumps)." },
        "database": {
          "type": "object",
          "required": ["engine", "format"],
          "properties": {
            "engine": { "enum": ["postgresql", "redis"] },
            "format": { "type": "string" },
            "service": { "type": "string" },
            "container": { "type": "string" }
          }
        }
      },
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": { "required": ["snapshot_id", "snapshot_source"] }
    }
  }
}
